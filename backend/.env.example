# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/civicpulse?retryWrites=true&w=majority

# AWS Learner Lab — credentials reset every 4 hours
# Copy from the "AWS Details" panel each session
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 + CloudFront
AWS_S3_BUCKET=civicpulse-images
AWS_CLOUDFRONT_URL=https://xxxxxxxxxxxx.cloudfront.net

# JWT (generate strong random strings — e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/civicpulse?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AWS Learner Lab — credentials reset every 4 hours
# Copy from the Learner Lab "AWS Details" panel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=          # required for Learner Lab
AWS_REGION=us-east-1

# AWS S3
AWS_S3_BUCKET=civicpulse-images

# AWS SES (starts in sandbox — use a verified email address)
AWS_SES_FROM=noreply@yourdomain.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Mapbox (public token — safe to expose on frontend, keep here for reference)
MAPBOX_TOKEN=pk.eyJ1IjoiLi4uIn0...

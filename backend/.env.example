# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/civicpulse?retryWrites=true&w=majority

# AWS Learner Lab — credentials reset every 4 hours
# Copy from the Learner Lab "AWS Details" panel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# AWS Cognito (created in Cognito console)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 (for issue photo uploads — next feature)
AWS_S3_BUCKET=civicpulse-images

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
